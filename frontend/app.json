{
  "expo": {
    "name": "GCSHARP",
    "slug": "GCSHARP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gcsharp.png",
    "scheme": "gcsharp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gcsharp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gcsharp.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gcsharp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/gcsharp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gcsharp.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d1d7945-b983-432e-af2a-9edc70fd3b63"
      }
    }
  }
}