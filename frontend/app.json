{
  "expo": {
    "name": "GCSHARP",
    "slug": "GCSHARP",
    "version": "2.5.7",
    "android": {
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gcsharp.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gcsharp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "orientation": "portrait",
    "icon": "./assets/images/gcsharp.png",
    "scheme": "gcsharp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/4ea50a82-7983-4ca0-bb9a-b22297bb304d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gcsharp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/gcsharp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gcsharp.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "./plugins/withRemoveReadMedia.js"
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ea50a82-7983-4ca0-bb9a-b22297bb304d"
      }
    },
    "owner": "gcsharp8"
  }
}