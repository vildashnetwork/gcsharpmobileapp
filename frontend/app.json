{
  "expo": {
    "name": "GCSHARP",
    "slug": "GCSHARP",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/gcsharp.png",
    "scheme": "gcsharp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gcsharp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gcsharp.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gcsharp",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/gcsharp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gcsharp.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#1D4ED8",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ea50a82-7983-4ca0-bb9a-b22297bb304d"
      }
    }
  }
}