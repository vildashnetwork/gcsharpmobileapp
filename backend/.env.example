# --- GC AI Engine (new) ------------------------------------------------
# Google Programmable Search (optional - keyless DuckDuckGo is used as fallback)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Google Gemini direct (optional) - makes GC AI independent of OpenRouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Existing OpenRouter config (now a FALLBACK, not the only provider)
# NOTE: OpenRouter/Gemini/Pollinations are NEVER used for tutor answers,
# explanations or video scripts at runtime - those come from GC_MODEL below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- GCSharp personal model (Phase 2 - REQUIRED for AI generation) ------
# Configure either GC_MODEL_URL, GC_MODEL_PATH, or both GC_MODEL_REPO_ID and
# GC_MODEL_FILE. See backend/DEPLOY_GCSHARP_MODEL.md.
# GC_MODEL_URL: self-hosted OpenAI-compatible server, e.g.
#   Ollama      -> http://localhost:11434/v1
#   llama.cpp   -> http://localhost:8080/v1
#   vLLM        -> http://localhost:8000/v1
GC_MODEL_URL=
# GC_MODEL_PATH: local GGUF weights for in-process llama-cpp-python inference
GC_MODEL_PATH=
# Optional: download a public GGUF from Hugging Face on first inference.
# Set both repo and file; inference still runs locally in this backend.
GC_MODEL_REPO_ID=
GC_MODEL_FILE=
GC_MODEL_REVISION=main
GC_MODEL_SHA256=
GC_MODEL_CACHE_DIR=
GC_MODEL_DOWNLOAD_TIMEOUT=600
# Optional knobs
GC_MODEL_NAME=gcsharp
GC_MODEL_API_KEY=
GC_MODEL_TIMEOUT=120
GC_MODEL_MAX_TOKENS=2048
GC_MODEL_TEMPERATURE=0.2
GC_MODEL_CTX=4096
GC_MODEL_N_THREADS=4

# --- Continuous knowledge growth (Phase 3) ------------------------------
KG_INTERVAL_HOURS=6
KG_MAX_TOPICS_PER_RUN=5
KG_MAX_SOURCES_PER_TOPIC=5
KG_MIN_QUALITY=0.45
KG_HOURS_BETWEEN_TOPIC=24

# --- Controlled training (Phase 4) --------------------------------------
# prepare_only (default): dataset prep + evaluation only, NO weight updates.
# hf/custom: runs GC_TRAIN_CMD with the prepared dataset path appended.
TR_BACKEND=prepare_only
GC_TRAIN_CMD=
TR_MIN_EXAMPLES=20
